{
    "name": "foodineers/locale",
    "description": "Laravel Package for handling multicountry and multilanguage websites",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "Foodineers",
        "laravel",
        "locale"
    ],
    "homepage": "https://github.com/foodineers/locale",
    "authors": [
        {
            "name": "Azzarip",
            "email": "marco.azzari@foodineers.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "foodineers/laravel-devtools": "dev-main",
        "orchestra/testbench": "*"
    },
    "autoload": {
        "psr-4": {
            "Foodineers\\Locale\\": "src/",
            "Foodineers\\Locale\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foodineers\\Locale\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",

    "lint": [
        "rector --ansi",
        "pint --parallel --ansi"
    ],
    "test:type-coverage": "pest --type-coverage --min=100",
    "test:lint": [
        "pint --parallel --test",
        "rector --dry-run --ansi"
    ],
    "pest": "pest --profile",
    "test:unit": "pest --parallel --coverage --exactly=100.0",
    "test:types": "phpstan --ansi",
     "test": [
        "@test:type-coverage",
        "@test:unit",
        "@test:lint",
        "@test:types"
    ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "llm/skills": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foodineers\\Locale\\LocaleServiceProvider"
            ]
        },
        "skills": {
            "source": "resources/skills"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
